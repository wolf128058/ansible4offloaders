# Bandwidth Monitor configuration
# Managed by Ansible — do not edit manually.

## Core
LISTEN={{ bandwidth_monitor_listen }}
LISTEN_PROTOCOL={{ bandwidth_monitor_listen_protocol }}
PROMISCUOUS={{ bandwidth_monitor_promiscuous }}

## Interface Selection
{% if bandwidth_monitor_interfaces %}
INTERFACES={{ bandwidth_monitor_interfaces }}
{% endif %}
{% if bandwidth_monitor_wan_interface %}
WAN_INTERFACE={{ bandwidth_monitor_wan_interface }}
{% endif %}

## GeoIP
GEO_CITY={{ bandwidth_monitor_geo_city }}
GEO_ASN={{ bandwidth_monitor_geo_asn }}

{% if bandwidth_monitor_unifi_url %}
## UniFi
UNIFI_URL={{ bandwidth_monitor_unifi_url }}
UNIFI_USER={{ bandwidth_monitor_unifi_user }}
UNIFI_PASS={{ bandwidth_monitor_unifi_pass }}
{% endif %}